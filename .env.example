# ------------------------------------------------------------------
# IMMO BURUNDI — API environment template
# Copy to apps/api/.env (monorepo dev) or .env at the repo root
# (standalone API) and fill in real values. Never commit .env.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MongoDB — local instance (default dev)
MONGODB_URI=mongodb://127.0.0.1:27017/immo-burundi

# Production lives on MongoDB Atlas. ALWAYS end an `mongodb+srv://` URI with a
# database name — without a path it silently resolves to the database named
# "test", so the API boots healthy and serves nothing:
#   MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mw7avba.mongodb.net/immo-burundi
#
# The production cluster is already seeded. Re-seeding is destructive: the
# script drops the whole database, so a non-local target additionally requires
#   SEED_ALLOW_PRODUCTION=true

# JWT
JWT_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS origins for the web app (comma separated)
WEB_ORIGIN=http://localhost:5173

# Public origin of THIS API, e.g. https://immo-burundi-server.onrender.com
# Only consulted by the LOCAL storage driver. Leave EMPTY when the web app
# reverse-proxies /api to the API (that is what netlify.toml does).
PUBLIC_BASE_URL=

# ── Keep-warm (Render free plan) ──────────────────────────────────────────────
# Render suspends a free service after ~15 min without traffic, and the next
# visitor waits ~1 min for it to boot. Enable this and the API pings its own
# /api/health on a timer so the instance never sleeps.
#
# KEEP_WARM_URL MUST be this service's PUBLIC origin, not http://localhost:PORT.
# Render only resets the idle timer for requests that reach its router, so a
# loopback ping would run forever without keeping anything awake. A loopback
# value is detected at boot and refused with an explanatory log.
#
# Trade-off: free plans meter 750 instance-hours per month and an instance that
# never sleeps bills the full month (~744h).
KEEP_WARM_ENABLED=false
KEEP_WARM_URL=
KEEP_WARM_INTERVAL_MS=20000

# Google OAuth — Sign in with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP — outgoing mail for agent account setup links.
# The app reads SMTP_PASSWORD (not SMTP_PASS); a mismatch leaves auth undefined.
# For Gmail use a 16-character App Password, not the account password.
# Missing SMTP config is not fatal: setup emails are simply skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=IMMO BURUNDI
SETUP_ACCOUNT_TTL_HOURS=72

# ------------------------------------------------------------------
# IMMO BURUNDI — Web (Frontend) environment template
# Copy to apps/web/.env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# Google Maps Embed API key (OPTIONAL).
# Maps render with real Google Maps even without a key (keyless embed).
# For production-scale, get a free key (25k loads/day) from:
#   https://console.cloud.google.com/google/maps-apis
#   -> enable "Maps Embed API" -> Credentials -> Create API key
#   -> restrict the key to your site's HTTP referrer.
VITE_GOOGLE_MAPS_KEY=

# ------------------------------------------------------------------
# Backend origin (deployment topology)
# ------------------------------------------------------------------
# The app assumes a SAME-ORIGIN backend: /api, /uploads and /socket.io are
# reverse-proxied to the API. That holds in dev (Vite proxy) and in production
# (netlify.toml forwards all three to Render), so leave these EMPTY there.
#
# Set VITE_API_BASE_URL to the Render URL to bypass the proxy and call the API
# cross-origin instead — the API's CORS allowlist is driven by WEB_ORIGIN.
# Note these are VITE_* vars: they are inlined at BUILD time on Netlify, so
# changing one requires a new deploy, not just a restart.
#   VITE_API_BASE_URL=https://immo-api.onrender.com
VITE_API_BASE_URL=
# Overrides where /uploads/* is served from. Defaults to VITE_API_BASE_URL.
VITE_UPLOADS_BASE_URL=
# Dev-only: where `pnpm dev:web` proxies /api, /uploads and /socket.io.
VITE_API_PROXY_TARGET=http://localhost:4000

# ------------------------------------------------------------------
# SEO / canonical origin (REQUIRED for search visibility)
# ------------------------------------------------------------------
# The production origin, no trailing slash. Every canonical link,
# Open Graph URL, sitemap.xml entry and JSON-LD @id is derived from this,
# so a wrong value here makes the whole site index under the wrong domain.
#   VITE_SITE_URL=https://www.immoburundi.bi
VITE_SITE_URL=

# Optional: prerender property detail pages at build time.
# When SEO_FETCH_API=1 and the API is reachable, `pnpm --filter @immo/web build`
# fetches published listings and writes static HTML for each of them into
# dist/property/<id>/index.html. When the API is down the build still
# succeeds, just without those pages.
# SEO_API_BASE=http://localhost:4000/api
SEO_API_BASE=
SEO_FETCH_API=0

# Redis / BullMQ (optional in Phase 1 — jobs interface stubbed)
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_ENABLED=false

# Storage abstraction. CLOUDINARY is the production driver: Render's
# filesystem is ephemeral, so LOCAL loses every upload on the next deploy
# while the database keeps pointing at /uploads/<file>. S3 is not implemented.
# With CLOUDINARY the API boots only when all three CLOUDINARY_* keys are set,
# and returns absolute res.cloudinary.com URLs, so PUBLIC_BASE_URL and the
# web app's /uploads proxy are no longer needed for images.
STORAGE_DRIVER=CLOUDINARY
STORAGE_LOCAL_DIR=./data/storage
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=

# Cloudinary — every uploaded image. Required when STORAGE_DRIVER=CLOUDINARY.
# Also used by `pnpm db:seed` to host the seed property photos; set
# SEED_CLOUDINARY_UPLOAD=false to keep the remote Unsplash URLs instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Uploads land in <CLOUDINARY_FOLDER>/uploads/<uuid>.
CLOUDINARY_FOLDER=immo
SEED_CLOUDINARY_UPLOAD=true

# Seed-on-boot admin (only used when DB empty)
# REQUIRED: seeding aborts if this is missing, shorter than 12 characters,
# or left as a placeholder value. Never commit a real password.
SEED_MAIN_ADMIN_PHONE=+25779000000
SEED_MAIN_ADMIN_EMAIL=admin@immoburundi.bi
SEED_MAIN_ADMIN_PASSWORD=change-me-before-deploying
