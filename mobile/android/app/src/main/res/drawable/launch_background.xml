<?xml version="1.0" encoding="utf-8"?>
<!--
  Light-mode launch window. #FFFFFF is AppColors.lightBg, so the window the user
  sees before Flutter's first frame is the same colour as the surface that
  replaces it and there is no flash.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
