<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8.0 and up mask the launcher icon, so the mark is supplied as a
  background colour plus a foreground vector and the system applies whatever
  shape it likes. API 25 and below fall back to the mipmap-*-dpi PNGs.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
