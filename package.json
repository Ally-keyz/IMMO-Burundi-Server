{
  "name": "@immo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IMMO BURUNDI — API. Real estate marketplace & brokerage backend.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "pnpm --filter @immo/shared-types build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "pnpm --filter @immo/shared-types build && tsc --noEmit",
    "db:seed": "tsx src/scripts/seed.ts",
    "media:to-cloudinary": "tsx src/scripts/migrateMediaToCloudinary.ts",
    "check:shared-types": "node scripts/check-shared-types.mjs"
  },
  "dependencies": {
    "@immo/shared-types": "workspace:*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.13.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
